<?xml version="1.0" encoding="utf-8"?>
<Application xmlns="http://schemas.microsoft.com/windows/2009/Ribbon">
  <Application.Commands>
    <Command Name="cmdButtonAbout" Id="2" LabelTitle="About" LabelDescription="关于数据来源 (&amp;A)" TooltipTitle="About" TooltipDescription="关于数据来源 (&amp;A)">
      <Command.SmallImages>
        <Image MinDPI="192">Icons/icons8-source-code-96.png</Image>
      </Command.SmallImages>
      <Command.LargeImages>
        <Image MinDPI="192">Icons/icons8-source-code-96.png</Image>
      </Command.LargeImages>
    </Command>
    <Command Name="cmdButtonOpenResponseCharts" Id="3" LabelTitle="Response Charts" LabelDescription="把电刺激实验记录下来的响应结果画成曲线图（横轴时间步 / 纵轴响应电信号强度）" TooltipDescription="把电刺激实验记录下来的响应结果画成曲线图（横轴时间步 / 纵轴响应电信号强度）">
      <Command.SmallImages>
        <Image MinDPI="192">Icons/icons8-rgb-histogram-96.png</Image>
      </Command.SmallImages>
      <Command.LargeImages>
        <Image MinDPI="192">Icons/icons8-rgb-histogram-96.png</Image>
      </Command.LargeImages>
    </Command>
    <Command Name="cmdButtonOpenSnakeGame" Id="4" LabelTitle="Snake GamePlay" LabelDescription="让果蝇大脑模型接管贪吃蛇的运动：实时画面 + 大脑神经元活动（并同步点亮三维点云）" TooltipDescription="让果蝇大脑模型接管贪吃蛇的运动：实时画面 + 大脑神经元活动（并同步点亮三维点云）">
      <Command.SmallImages>
        <Image MinDPI="192">Icons/icons8-ai-96.png</Image>
      </Command.SmallImages>
      <Command.LargeImages>
        <Image MinDPI="192">Icons/icons8-ai-96.png</Image>
      </Command.LargeImages>
    </Command>
    <Command Name="cmdToggleSimulationExperiment" Id="5" LabelTitle="Simulation Experiment" TooltipTitle="电刺激模式" TooltipDescription="勾选后：在神经元上按住左键（越久越强），松开即运行一次全脑 SNN 仿真并回放激活过程">
      <Command.SmallImages>
        <Image MinDPI="192">Icons/icons8-goto-96.png</Image>
      </Command.SmallImages>
      <Command.LargeImages>
        <Image MinDPI="192">Icons/icons8-goto-96.png</Image>
      </Command.LargeImages>
    </Command>
    <Command Name="cmdButtonResetView" Id="6" LabelTitle="Reset View" LabelDescription="重置视角 (&amp;R)" TooltipDescription="菜单「视图 → 重置视角」：把三维画布恢复到默认视角。">
      <Command.SmallImages>
        <Image MinDPI="192">Icons/icons8-refresh-96.png</Image>
      </Command.SmallImages>
      <Command.LargeImages>
        <Image MinDPI="192">Icons/icons8-refresh-96.png</Image>
      </Command.LargeImages>
    </Command>
    <Command Name="cmdButtonOpenModelDir" Id="7" LabelTitle="Open Model" LabelDescription="打开数据目录 (&amp;O)..." TooltipDescription="打开数据目录 (&amp;O)...">
      <Command.SmallImages>
        <Image MinDPI="192">Icons/icons8-file-explorer-new-96.png</Image>
      </Command.SmallImages>
      <Command.LargeImages>
        <Image MinDPI="192">Icons/icons8-file-explorer-new-96.png</Image>
      </Command.LargeImages>
    </Command>
    <Command Name="cmdButtonMakeScreenshot" Id="8" LabelTitle="Screenshot" TooltipDescription="保存截图 (&amp;S)...">
      <Command.SmallImages>
        <Image MinDPI="192">Icons/applets-screenshooter.png</Image>
      </Command.SmallImages>
      <Command.LargeImages>
        <Image MinDPI="192">Icons/applets-screenshooter.png</Image>
      </Command.LargeImages>
    </Command>
    <Command Name="cmdButtonOpenCanvas" Id="9" LabelTitle="Open Canvas">
      <Command.SmallImages>
        <Image MinDPI="192">Icons/TextEditor.png</Image>
      </Command.SmallImages>
      <Command.LargeImages>
        <Image MinDPI="192">Icons/TextEditor.png</Image>
      </Command.LargeImages>
    </Command>
    <Command Name="cmdToggleShowGroundGrid" Id="10" LabelTitle="Show Grid" TooltipDescription="显示网格">
      <Command.SmallImages>
        <Image MinDPI="192">Icons/icons8-layers-96.png</Image>
      </Command.SmallImages>
      <Command.LargeImages>
        <Image MinDPI="192">Icons/icons8-layers-96.png</Image>
      </Command.LargeImages>
    </Command>
    <Command Name="cmdNumIntensity" Id="11" LabelTitle="Intensity: " />
    <Command Name="cmdNumSimulationSteps" Id="12" LabelTitle="Steps: " />
    <Command Name="cmdToggleShowConnection" Id="13" LabelTitle="Show Connection" TooltipDescription="显示神经元连接">
      <Command.SmallImages>
        <Image MinDPI="192">Icons/icons8-mind-map-96.png</Image>
      </Command.SmallImages>
      <Command.LargeImages>
        <Image MinDPI="192">Icons/icons8-mind-map-96.png</Image>
      </Command.LargeImages>
    </Command>
    <Command Name="cmdNumSynapseCutoff" Id="14" LabelTitle="Synapse: " />
    <Command Name="cmdNumScatterSize" Id="15" LabelTitle="Scatter Size: " />
    <Command Name="cmdButtonExit" Id="16" LabelTitle="Exit">
      <Command.SmallImages>
        <Image MinDPI="192">Icons/icons8-exit-96.png</Image>
      </Command.SmallImages>
      <Command.LargeImages>
        <Image MinDPI="192">Icons/icons8-exit-96.png</Image>
      </Command.LargeImages>
    </Command>
    <Command Name="cmdGroupDisplayOptions" Id="17" LabelTitle="Display Options" />
    <Command Name="cmdGroupInformation" Id="18" LabelTitle="Information" />
    <Command Name="cmdGroupWorkbenchTools" Id="19" LabelTitle="Tools" />
    <Command Name="cmdGroupWorkbench" Id="20" LabelTitle="Workbench" />
    <Command Name="cmdMenuWorkbench" Id="21" LabelTitle="Flywire AI" />
    <Command Name="cmdGroupDisplayParameters" Id="22" LabelTitle="Display Parameters" />
    <Command Name="cmdGroupExperimentParameters" Id="23" LabelTitle="Experiment Parameters" />
    <Command Name="cmdTabCanvasOptions" Id="24" LabelTitle="Canvas Options" />
    <Command Name="cmdMenuSimulationExperiment" Id="25" LabelTitle="Simulation Experiment" />
  </Application.Commands>
  <Application.Views>
    <Ribbon>
      <Ribbon.ApplicationMenu>
        <ApplicationMenu>
          <MenuGroup>
            <Button CommandName="cmdButtonOpenModelDir" />
          </MenuGroup>
          <MenuGroup>
            <Button CommandName="cmdButtonAbout" />
            <Button CommandName="cmdButtonExit" />
          </MenuGroup>
        </ApplicationMenu>
      </Ribbon.ApplicationMenu>
      <Ribbon.QuickAccessToolbar>
        <QuickAccessToolbar />
      </Ribbon.QuickAccessToolbar>
      <Ribbon.ContextualTabs>
        <TabGroup CommandName="cmdMenuSimulationExperiment">
          <Tab>
            <Group CommandName="cmdGroupExperimentParameters">
              <Spinner CommandName="cmdNumIntensity" />
              <Spinner CommandName="cmdNumSimulationSteps" />
            </Group>
          </Tab>
        </TabGroup>
      </Ribbon.ContextualTabs>
      <Ribbon.Tabs>
        <Tab CommandName="cmdMenuWorkbench">
          <Group CommandName="cmdGroupWorkbench" SizeDefinition="ThreeButtons">
            <Button CommandName="cmdButtonOpenModelDir" />
            <Button CommandName="cmdButtonOpenCanvas" />
            <Button CommandName="cmdButtonMakeScreenshot" />
          </Group>
          <Group CommandName="cmdGroupWorkbenchTools" SizeDefinition="FourButtons">
            <Button CommandName="cmdButtonOpenResponseCharts" />
            <Button CommandName="cmdButtonOpenSnakeGame" />
            <ToggleButton CommandName="cmdToggleSimulationExperiment" />
            <Button CommandName="cmdButtonResetView" />
          </Group>
          <Group CommandName="cmdGroupInformation" SizeDefinition="OneButton">
            <Button CommandName="cmdButtonAbout" />
          </Group>
        </Tab>
        <Tab CommandName="cmdTabCanvasOptions">
          <Group CommandName="cmdGroupDisplayOptions" SizeDefinition="TwoButtons">
            <ToggleButton CommandName="cmdToggleShowGroundGrid" />
            <ToggleButton CommandName="cmdToggleShowConnection" />
          </Group>
          <Group CommandName="cmdGroupDisplayParameters">
            <Spinner CommandName="cmdNumSynapseCutoff" />
            <Spinner CommandName="cmdNumScatterSize" />
          </Group>
        </Tab>
      </Ribbon.Tabs>
    </Ribbon>
    <ContextPopup />
  </Application.Views>
</Application>
<!--ResourceName Value="APPLICATION"-->